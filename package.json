  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.70.0",
    "vite": "^6.0.3"
  }
