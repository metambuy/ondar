{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ondar",
  "version": "0.1.1",
  "identifier": "eu.ondar.radio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "resources/map/world.ondarmap": "map/world.ondarmap"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/metambuy/ondar/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQUQxNDQwMDNDODk2NjcKUldSbmxzZ0RRQlN0UGV4akhiSktuWXU0RjArRGtkbVVXODl2K3VjSSt3RWpuWXlkbnF0SkM0V1EK"
    }
  }
}
